APP_ENV=development
APP_NAME=zidicommerce
SERVER_PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Prefer DATABASE_URL in deployed environments.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zidicommerce?sslmode=disable
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=zidicommerce
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=Africa/Lagos

JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=zidicommerce
JWT_TTL_MINUTES=1440

MIGRATIONS_DIR=migrations

# Local AI test chat. Phase B supports the same grounded pipeline for Ollama or Groq.
AI_PROVIDER=ollama
AI_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
AI_MAX_TOOL_CALLS=4
AI_EMBEDDINGS_ENABLED=false
AI_VECTOR_SEARCH_ENABLED=false
AI_EMBEDDING_PROVIDER=disabled
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_VECTOR_SEARCH_THRESHOLD=0.72

# Channel provider secrets can be saved encrypted when this is a 32-byte raw,
# hex, or base64 key. Credential rows store only dbenc:// references.
CHANNEL_SECRET_ENCRYPTION_KEY=
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# Public API origin used for the shared Embedded Signup webhook and legacy
# connection-specific callback URLs. Production deployments must use HTTPS.
WHATSAPP_WEBHOOK_PUBLIC_BASE_URL=
# Local signature bypass is off by default and is rejected in production.
WHATSAPP_SIGNATURE_BYPASS=false
# These values may be referenced as env://WHATSAPP_* from a channel credential.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
# Meta Embedded Signup. Keep META_APP_SECRET and the webhook token server-side.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIGURATION_ID=
META_GRAPH_API_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
PAYMENT_PROVIDER=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

EMAIL_MODE=log
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
EMAIL_FROM=noreply@zidicommerce.local
EMAIL_FROM_NAME=ZidiCommerce
APP_BASE_URL=http://localhost:3000

# Field-service pilot tenant (optional, opt-in).
# FIELD_SERVICE_DEMO_SEED=true seeds the Lagos Home Services demo organization
# on startup. The seed is idempotent and scoped to its own tenant.
# Always set FIELD_SERVICE_DEMO_PASSWORD outside local development.
FIELD_SERVICE_DEMO_SEED=
FIELD_SERVICE_DEMO_PASSWORD=
# Optional second tenant profile. The JSON contains only non-secret tenant data;
# credentials stay in FIELD_SERVICE_PILOT_PASSWORD.
FIELD_SERVICE_PILOT_SEED_PROFILE=
FIELD_SERVICE_PILOT_PASSWORD=
FIELD_SERVICE_PORTAL_URL=
# Domain used to build a placeholder email for WhatsApp customers who have none.
# Must be a real, valid domain: payment providers reject reserved TLDs (.local).
FIELD_SERVICE_CUSTOMER_EMAIL_DOMAIN=
