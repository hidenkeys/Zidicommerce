APP_ENV=development
APP_NAME=zidicommerce
SERVER_PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Prefer DATABASE_URL in deployed environments.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zidicommerce?sslmode=disable
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=zidicommerce
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=Africa/Lagos

JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=zidicommerce
JWT_TTL_MINUTES=1440

MIGRATIONS_DIR=migrations

# Future integrations. Keep empty until later phases.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
PAYMENT_PROVIDER=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@zidicommerce.local
APP_BASE_URL=http://localhost:3000
