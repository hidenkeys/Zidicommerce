APP_ENV=development
APP_NAME=zidicommerce
SERVER_PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Prefer DATABASE_URL in deployed environments.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zidicommerce?sslmode=disable
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=zidicommerce
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=Africa/Lagos

JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=zidicommerce
JWT_TTL_MINUTES=1440

MIGRATIONS_DIR=migrations

# Future integrations. Keep empty until later phases.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
PAYMENT_PROVIDER=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

EMAIL_MODE=log
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
EMAIL_FROM=noreply@zidicommerce.local
EMAIL_FROM_NAME=ZidiCommerce
APP_BASE_URL=http://localhost:3000

# Field-service pilot tenant (optional, opt-in).
# FIELD_SERVICE_DEMO_SEED=true seeds the Lagos Home Services demo organization
# on startup. The seed is idempotent and scoped to its own tenant.
# Always set FIELD_SERVICE_DEMO_PASSWORD outside local development.
FIELD_SERVICE_DEMO_SEED=
FIELD_SERVICE_DEMO_PASSWORD=
FIELD_SERVICE_PORTAL_URL=
