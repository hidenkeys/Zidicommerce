FROM golang:1.23-alpine AS builder

WORKDIR /src/apps/api
COPY apps/api/go.mod apps/api/go.sum ./
RUN go mod download
COPY apps/api ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/zidicommerce-api ./cmd/api

FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S zidicommerce \
    && adduser -S -G zidicommerce zidicommerce

WORKDIR /app
COPY --from=builder /out/zidicommerce-api ./zidicommerce-api
COPY migrations ./migrations

USER zidicommerce
EXPOSE 8080

CMD ["./zidicommerce-api"]
