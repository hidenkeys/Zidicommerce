{
  "name": "@zidicommerce/admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "check": "tsc --noEmit && vite build --configLoader runner --outDir /tmp/zidicommerce-admin-dist --emptyOutDir",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test:staging:studio": "node tests/staging-studio.mjs",
    "test:components": "node --test tests/*.test.mjs",
    "test:staging:navigation": "node tests/staging-navigation.mjs"
  },
  "dependencies": {
    "@zidicommerce/shared": "*",
    "lucide-react": "^1.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.65.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
