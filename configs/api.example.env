APP_ENV=development
APP_NAME=zidicommerce
SERVER_PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zidicommerce?sslmode=disable
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=zidicommerce
JWT_TTL_MINUTES=1440
MIGRATIONS_DIR=../../migrations
PAYMENT_PROVIDER=test
PAYSTACK_SECRET_KEY=
PAYMENT_SECRET_ENCRYPTION_KEY=
EMAIL_MODE=log
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=starttls
EMAIL_FROM=noreply@zidicommerce.local
EMAIL_FROM_NAME=ZidiCommerce
APP_BASE_URL=http://localhost:3000

# Optional one-time recovery only. Keep empty during normal startup.
WHATSAPP_ADOPT_PHONE_NUMBER_ID=
WHATSAPP_ADOPT_TARGET_ORG_SLUG=
WHATSAPP_ADOPT_VERIFY_TOKEN=
WHATSAPP_ADOPT_BOT_ID=
